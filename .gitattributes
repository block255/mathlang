# 统一行尾：源码与文档一律 LF（避免 Windows 上 CRLF 反复扰动 diff）
* text=auto

*.dart   text eol=lf
*.md     text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.json   text eol=lf
*.js     text eol=lf
*.html   text eol=lf
*.css    text eol=lf

# Windows 脚本保持 CRLF（.ps1 还必须带 UTF-8 BOM、.cmd 不能带 —— 见工作区约定）
*.ps1    text eol=crlf
*.cmd    text eol=crlf
*.bat    text eol=crlf

# 二进制
*.png    binary
*.jpg    binary
*.jpeg   binary
*.ttf    binary
*.otf    binary
*.jks    binary
*.keystore binary
